# Optional local-only overrides. The guided zero-budget baseline needs no secrets.
# Keep the literal loopback hostname: localhost is intentionally not equivalent.
PLAYLIST_TRANSFER_ORIGIN=http://127.0.0.1:3210

# Relative paths resolve from the project directory. This directory is gitignored.
PLAYLIST_TRANSFER_DATA_DIR=.data

# Optional provider endpoints are fail-closed in the distributable baseline.
# Enable only after the local operator has reviewed the current provider terms,
# configured an appropriate OAuth consent screen/privacy contact, and accepted
# responsibility for compliance. Guided URL/manual workflows need neither flag.
PLAYLIST_TRANSFER_ENABLE_YOUTUBE_API=disabled

# Optional one-time release-owner setup. This is a public OAuth identifier, not
# a secret. When configured, people using this build only click “Войти через
# Google”; the advanced BYO Client ID field remains available as a fallback.
PLAYLIST_TRANSFER_YOUTUBE_CLIENT_ID=

PLAYLIST_TRANSFER_ENABLE_PROVIDER_OEMBED=disabled
